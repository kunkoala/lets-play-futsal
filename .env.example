# Copy this file to .env (and/or .env.local) and fill in real values.
# Never commit .env or .env.local — only this .env.example is tracked.

# Full Postgres connection string. Locally this points at localhost (after
# `docker compose up -d db`); in prod (Coolify) it points at the `db` compose
# service hostname instead.
DATABASE_URL=postgresql://futsal:futsal@localhost:5432/futsal

# Credentials used to configure the `db` container itself (docker-compose.yml).
POSTGRES_USER=futsal
POSTGRES_PASSWORD=futsal
POSTGRES_DB=futsal

# The one admin account's password (compared on /login, no user table).
ADMIN_PASSWORD=change-me

# 32+ random characters used to sign the admin session JWT (jose).
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Timezone the /admin/analytics day and hour buckets are cut in,
# so "yesterday" means the club's yesterday rather than UTC's.
ANALYTICS_TZ=Asia/Jakarta
