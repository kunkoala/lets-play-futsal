// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Domain model — see PLAN.md §3 for the source of truth.
//
// Modeling notes:
// - Model names are PascalCase, fields are camelCase; underlying table/column
//   names are snake_case via @@map/@map to match PLAN.md §3 exactly.
// - Status/type string-unions from PLAN.md are modeled as native Postgres
//   enums (mapped to snake_case enum type names) rather than plain strings,
//   so illegal values are impossible at the DB layer.
// - Deliberately NOT modeled here (per PLAN.md "Rules and derivations"):
//   no stored match score, no stored win/draw/loss, no `stat`/leaderboard
//   table. All of that is derived from `GoalEvent` rows at query time. The
//   extended stats (G+A, per-match rates, points, form, clean sheets, +/-,
//   braces/hat-tricks, MVP counts) are derivations too — see src/lib/stats.ts.
//   `Session.mvpPlayerId` and `TeamPlayer.isKeeper` are the exceptions that
//   must be stored: they record human decisions (who was picked, who went in
//   goal), which no amount of goal-event arithmetic can recover.
// - Referential actions: rows that only make sense as children of a
//   session/team/match (Attendance, Team, TeamPlayer, Match, GoalEvent) use
//   onDelete: Cascade on that parent link — including Match.homeTeam/
//   awayTeam and GoalEvent.team, which point at Team (a Session-owned child,
//   never deleted independently): confirmed live that leaving those at the
//   Prisma default (RESTRICT) makes deleting a Session fail intermittently,
//   because Postgres resolves the sibling Session -> Team and Session ->
//   Match cascades without guaranteeing Match/GoalEvent rows referencing a
//   team are gone before that team's RESTRICT check runs. Links to Player
//   are left at the DB default (RESTRICT for required FKs, SET NULL for the
//   optional scorer/assist FKs), so a player with any Attendance/GoalEvent/
//   TeamPlayer row cannot be deleted — matches "deactivate instead of
//   delete" in PLAN.md §3. Season is never deleted by any v1 feature, so its
//   Award/Session links are also left at the default RESTRICT.
// - `@@unique([sessionId, seq])` on Match and `@@unique([matchId, seq])` on
//   GoalEvent are additions beyond the letter of PLAN.md §3 (which only
//   specifies seq as "order within the day/match"): they prevent duplicate
//   ordering bugs and cost nothing later phases would rely on differently.
// ---------------------------------------------------------------------------

enum SessionStatus {
  draft
  teams_set
  completed

  @@map("session_status")
}

enum MatchStatus {
  in_progress
  finished

  @@map("match_status")
}

enum AwardType {
  mvp

  @@map("award_type")
}

/// How willing a player is to go in goal, used by the shuffle to seed one
/// keeper per team before dealing the outfield remainder (see src/lib/shuffle.ts):
/// `goalkeeper` = dedicated (always placed in goal if a slot exists),
/// `flexible` = will keep only to fill a team that has no dedicated keeper,
/// `outfield` = never auto-assigned.
enum KeeperPref {
  outfield
  flexible
  goalkeeper

  @@map("keeper_pref")
}

model Season {
  id       Int      @id @default(autoincrement())
  name     String
  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date
  isActive Boolean  @default(false) @map("is_active")

  sessions Session[]
  awards   Award[]

  @@map("season")
}

model Player {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  isActive   Boolean    @default(true) @map("is_active")
  keeperPref KeeperPref @default(outfield) @map("keeper_pref")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  attendances     Attendance[]
  teamMemberships TeamPlayer[]
  matchLineups    MatchPlayer[]
  goalsScored     GoalEvent[]   @relation("GoalEventScorer")
  assistsGiven    GoalEvent[]   @relation("GoalEventAssist")
  awards          Award[]
  sessionMvps     Session[]     @relation("SessionMvp")

  @@map("player")
}

model Session {
  id          Int           @id @default(autoincrement())
  seasonId    Int           @map("season_id")
  date        DateTime      @db.Date
  notes       String?
  status      SessionStatus @default(draft)
  // Player of the day, picked by the admin from everyone who turned up, once
  // per matchday rather than once per match. Optional — a session may finish
  // without a pick, and the pick stays editable afterwards.
  //
  // Deliberately has no effect on anything derived: `rating.ts` does not read
  // it, so this is a fun award that cannot be farmed into a better rating.
  // Left at the Prisma default for an optional FK (SET NULL), like
  // GoalEvent.scorer/assist. Distinct from `Award`/`AwardType.mvp`, which is
  // the *season* MVP.
  mvpPlayerId Int?          @map("mvp_player_id")

  season      Season       @relation(fields: [seasonId], references: [id])
  mvpPlayer   Player?      @relation("SessionMvp", fields: [mvpPlayerId], references: [id])
  attendances Attendance[]
  teams       Team[]
  matches     Match[]

  @@index([seasonId])
  @@index([mvpPlayerId])
  @@map("session")
}

model Attendance {
  sessionId Int @map("session_id")
  playerId  Int @map("player_id")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id])

  @@id([sessionId, playerId])
  @@map("attendance")
}

model Team {
  id         Int    @id @default(autoincrement())
  sessionId  Int    @map("session_id")
  name       String
  color      String
  // Which shuffle round these teams belong to, within this one session.
  // Reshuffling mid-session (see reshuffleTeams in admin/sessions/actions.ts)
  // creates a NEW generation of Team rows rather than deleting the old ones —
  // those are still referenced by whatever matches/goal_events they already
  // played, and Team has onDelete: Cascade from Session, so deleting them
  // would take those finished matches with them. Pages that show "the
  // current teams" (roster panel, next-match picker) filter to
  // max(generation) for the session; MatchesSoFar's roster lookup (keyed by
  // team id, for MVP picking) intentionally does not filter, since it needs
  // every generation a match was actually played under.
  generation Int    @default(1)

  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  players      TeamPlayer[]
  matchLineups MatchPlayer[]
  homeMatches  Match[]       @relation("MatchHomeTeam")
  awayMatches  Match[]       @relation("MatchAwayTeam")
  goalEvents   GoalEvent[]

  @@index([sessionId])
  @@map("team")
}

/// Who the shuffle put on this team — the team sheet, and the default lineup
/// every match of theirs starts from.
///
/// Deliberately NOT the source of any stat. It used to be: every derivation
/// read `Team.players` at query time, which meant substituting someone
/// mid-session retroactively rewrote every match that team had already
/// played. `MatchPlayer` records who was actually on the pitch for a given
/// match; this stays the roster you edit between games.
model TeamPlayer {
  teamId   Int     @map("team_id")
  playerId Int     @map("player_id")
  // Set by the shuffle, not by the player's own preference: it records who is
  // expected to go in goal for this team, and seeds MatchPlayer.isKeeper.
  isKeeper Boolean @default(false) @map("is_keeper")

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@id([teamId, playerId])
  @@map("team_player")
}

/// Who actually played in one match, snapshotted when the match starts.
///
/// This exists so a substitution is a local fact. Before it, stats came from
/// the session-scoped team roster, so dropping a tired player out after match
/// 3 also removed them from matches 1-3 — their goals stayed (goal events
/// point at players directly) but their appearances, results, clean sheets and
/// +/- all silently changed. Now the lineup is copied from `TeamPlayer` at
/// kick-off and never revisited, so editing the roster afterwards only affects
/// matches that haven't started.
///
/// `isKeeper` is copied per match too: whoever went in goal for *this* game is
/// what the clean-sheet and goals-conceded numbers need, and that can change
/// between matches on the same matchday.
///
/// Cascades mirror GoalEvent for the same reason documented there — Team is a
/// compositional child of Session, and a RESTRICT here would race the sibling
/// Session -> Team cascade when a session is deleted.
model MatchPlayer {
  matchId  Int     @map("match_id")
  playerId Int     @map("player_id")
  teamId   Int     @map("team_id")
  isKeeper Boolean @default(false) @map("is_keeper")

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@id([matchId, playerId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
  @@map("match_player")
}

model Match {
  id             Int         @id @default(autoincrement())
  sessionId      Int         @map("session_id")
  seq            Int
  homeTeamId     Int         @map("home_team_id")
  awayTeamId     Int         @map("away_team_id")
  status         MatchStatus @default(in_progress)
  startedAt      DateTime    @default(now()) @map("started_at") @db.Timestamptz
  endedAt        DateTime?   @map("ended_at") @db.Timestamptz
  // --- Match clock (see src/lib/matchClock.ts for the arithmetic) ---
  // The clock is derived from these timestamps rather than counted in the
  // browser, so it survives a reload, a sleeping iPad, or a second admin
  // opening the same match on another device.
  //
  // Planned length. Nullable because matches recorded before the timer
  // existed have no agreed duration — those count up instead of down rather
  // than being retro-fitted one.
  durationSec    Int?        @map("duration_sec")
  // Set while the clock is stopped for the water break, null while running.
  pausedAt       DateTime?   @map("paused_at") @db.Timestamptz
  // Seconds already spent paused, excluded from elapsed time so the second
  // half still gets its full share.
  pausedTotalSec Int         @default(0) @map("paused_total_sec")
  // Stamped when the halfway water break is taken, so resuming play doesn't
  // immediately trip the break again.
  breakTakenAt   DateTime?   @map("break_taken_at") @db.Timestamptz

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // homeTeam/awayTeam cascade too: Team only ever exists as a child of the
  // same Session (never deleted independently), so when a Session is torn
  // down, Postgres's cascade from Session -> Team and Session -> Match fire
  // "in parallel" — a RESTRICT here would race against that and can reject
  // the delete depending on cascade resolution order. See GoalEvent.team.
  homeTeam   Team          @relation("MatchHomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam   Team          @relation("MatchAwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  goalEvents GoalEvent[]
  lineup     MatchPlayer[]

  @@unique([sessionId, seq])
  @@index([sessionId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@map("match")
}

model GoalEvent {
  id        Int      @id @default(autoincrement())
  matchId   Int      @map("match_id")
  seq       Int
  teamId    Int      @map("team_id")
  scorerId  Int?     @map("scorer_id")
  assistId  Int?     @map("assist_id")
  // Elapsed match clock (see src/lib/matchClock.ts) at the moment the goal was
  // recorded, snapshotted rather than derived after the fact: reconstructing
  // it later would need every pause window the match ever had, but only the
  // current cumulative pausedTotalSec is stored. Null for goals recorded
  // before this column existed, and for matches with no clock at all.
  matchSec  Int?     @map("match_sec")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  // Cascade from Team too, for the same reason as Match.homeTeam/awayTeam
  // above: Team is a compositional child of Session, deleted only as part
  // of tearing down the whole session subtree, and a RESTRICT here raced
  // against the sibling Session -> Team cascade (observed via a real
  // FK-violation error while re-running prisma/seed.ts against a live DB).
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scorer Player? @relation("GoalEventScorer", fields: [scorerId], references: [id])
  assist Player? @relation("GoalEventAssist", fields: [assistId], references: [id])

  @@unique([matchId, seq])
  @@index([matchId])
  @@index([teamId])
  @@index([scorerId])
  @@index([assistId])
  @@map("goal_event")
}

/// What kind of thing a row in `analytics_event` records.
/// `pageview` = one route render seen by one visitor;
/// `impression` = a tracked element (a player row, a session card) actually
/// scrolled into view, deduplicated to once per visit per target client-side;
/// `action` = a deliberate interaction worth counting (share, outbound click).
enum AnalyticsEventType {
  pageview
  impression
  action

  @@map("analytics_event_type")
}

/// First-party, cookie-based analytics — see src/lib/analytics.ts (queries),
/// src/app/api/track/route.ts (collection) and src/components/analytics/
/// (the client beacons).
///
/// Deliberately privacy-light: no IP address, no fingerprint, no third-party
/// script. A visitor is a random UUID in an HTTP-only first-party cookie, and
/// the only request-derived fields kept are the coarse ones (device class,
/// browser family, OS, edge-provided country) that can't single anyone out.
/// Known bots are dropped at the endpoint rather than stored and filtered later.
///
/// This is an append-only event log: no counters are incremented in place, so
/// any new metric can be derived from history rather than needing to have been
/// planned for. `dwellMs` is the single exception — it lands on the pageview
/// row itself, because a dwell time belongs to the view it measures and is
/// stitched back on by `clientEventId`.
model AnalyticsEvent {
  id Int @id @default(autoincrement())

  type  AnalyticsEventType
  /// Route pattern with dynamic segments collapsed, e.g. `/players/[id]` —
  /// this is what the dashboard groups by, so a hundred player profiles read
  /// as one popular route instead of a hundred one-view rows.
  route String
  /// The concrete path as visited (`/players/12`), kept for drill-down.
  path  String

  /// For impression/action rows: what was seen or done ("player_row",
  /// "session_card", "share_click"), plus the domain id when there is one.
  name     String?
  targetId Int?    @map("target_id")

  /// Random UUID from the `_lpf_vid` cookie (1 year) — stable-ish identity for
  /// "unique visitors", with no personal data behind it.
  visitorId String @map("visitor_id")
  /// Random UUID from the `_lpf_vis` cookie, rolling 30-minute expiry, so a
  /// "visit" ends after half an hour of inactivity like every other analytics
  /// tool defines it.
  visitId   String @map("visit_id")

  /// Referrer host only (`google.com`), never the full URL — the path of the
  /// page someone came from is theirs, not ours.
  referrerHost String? @map("referrer_host")

  device  String?
  browser String?
  os      String?
  /// Two-letter country from the reverse proxy/CDN header when one is present
  /// (`cf-ipcountry`, `x-vercel-ip-country`); null on a bare deploy.
  country String?

  /// Set when the request carried a valid admin session cookie, so the admin's
  /// own browsing can be excluded from every figure on the dashboard without
  /// throwing the rows away.
  isAdmin Boolean @default(false) @map("is_admin")

  /// Milliseconds the pageview stayed visible, patched onto the row when the
  /// tab is hidden or closed. Null for events that never reported back
  /// (closed too fast, beacon dropped) and for non-pageview rows.
  dwellMs Int? @map("dwell_ms")

  /// Client-generated UUID for this event. Unique, which does double duty: it
  /// is how the later dwell beacon finds the pageview it belongs to, and it
  /// makes the whole endpoint idempotent — a retried or duplicated beacon
  /// collides instead of inflating the count.
  clientEventId String? @unique @map("client_event_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([visitorId])
  @@index([route, createdAt])
  @@index([name, targetId])
  @@map("analytics_event")
}

model Award {
  id       Int       @id @default(autoincrement())
  seasonId Int       @map("season_id")
  type     AwardType
  playerId Int       @map("player_id")

  season Season @relation(fields: [seasonId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([seasonId, type])
  @@map("award")
}
